# Copy to .env; keep keys server-side and out of Git. GEMINI_MODEL is shared
# by both hosts: asset-generation default is gemini-3.8-flash; durable-world
# host default is gemini-4-argon when this variable is unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_AGENT=antigravity-preview-09-2026
PORT=4317
PLAYWRIGHT_BROWSERS_PATH=.data/browsers
# Enable only after choosing a live inference spending ceiling.
THEME_INFERENCE_ENABLED=0

# Durable-world development runtime settings. Keep API keys blank in examples.
DIPLOMACY_INTERVAL_SECONDS=10
# Total attempts per saved diplomacy world, including failed calls (1–1024).
DIPLOMACY_MAX_CALLS=120
