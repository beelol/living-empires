#!/bin/sh

# Synchronous by design: Git must not start detached work after the commit.
warn() {
  printf 'codex auto-push: %s\n' "$1" >&2
}

if [ "${CODEX_SKIP_AUTO_PUSH:-}" = "1" ]; then
  exit 0
fi

repo=$(git rev-parse --show-toplevel 2>/dev/null) || {
  warn 'could not locate the repository; commit remains local.'
  exit 0
}
branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null) || exit 0
if [ "$branch" != "main" ]; then
  exit 0
fi

sha=$(git -C "$repo" rev-parse HEAD 2>/dev/null) || {
  warn 'could not read the committed revision; commit remains local.'
  exit 0
}

if GIT_TERMINAL_PROMPT=0 git -C "$repo" push origin "$sha:refs/heads/main"; then
  if git -C "$repo" config codex.lastPushedCommit "$sha"; then
    printf 'codex auto-push: pushed %s to origin/main.\n' "$sha" >&2
  else
    warn "push succeeded for $sha, but the local sync marker could not be written."
  fi
else
  warn 'push to origin/main failed; the local commit remains committed and can be pushed later.'
fi

# A post-commit failure must never make a successful local commit look failed.
exit 0
